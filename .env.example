PRINTSETU_PRODUCT_NAME=PrintSetu
PRINTSETU_ENV=local
PRINTSETU_DATABASE_URL=sqlite:///./printsetu.db
PRINTSETU_STORAGE_DIR=./storage
PRINTSETU_JWT_SECRET=change-me-in-production
PRINTSETU_DEMO_MODE=true
PRINTSETU_PAYMENT_REQUIRED=false
PRINTSETU_ALLOW_UNPAID_LOCAL_PRINTING=true
PRINTSETU_AGENT_POLL_SECONDS=3
PRINTSETU_SERVER_URL=http://127.0.0.1:8000
PRINTSETU_PUBLIC_URL=
PRINTSETU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PRINTSETU_OTP_MODE=development
PRINTSETU_RESEND_API_KEY=
PRINTSETU_RESEND_SENDER=PrintSetu <onboarding@resend.dev>
# disabled = local unpaid demo; test = Razorpay sandbox (requires keys)
PRINTSETU_RAZORPAY_MODE=disabled
PRINTSETU_RAZORPAY_KEY_ID=
PRINTSETU_RAZORPAY_KEY_SECRET=
PRINTSETU_RAZORPAY_WEBHOOK_SECRET=
PRINTSETU_CLEANUP_INTERVAL_SECONDS=60
PRINTSETU_DOCUMENT_RETENTION_HOURS=6
PRINTSETU_MAX_UPLOAD_BYTES=26214400

