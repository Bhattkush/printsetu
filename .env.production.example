PRINTSETU_ENV=production
PRINTSETU_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
PRINTSETU_STORAGE_DIR=/data/documents
PRINTSETU_JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PRINTSETU_PUBLIC_URL=https://print.example.com
PRINTSETU_SERVER_URL=https://print.example.com
PRINTSETU_ALLOWED_ORIGINS=https://print.example.com
PRINTSETU_DEMO_MODE=false
PRINTSETU_PAYMENT_REQUIRED=true
PRINTSETU_ALLOW_UNPAID_LOCAL_PRINTING=false
PRINTSETU_OTP_MODE=resend
PRINTSETU_RESEND_API_KEY=
PRINTSETU_RESEND_SENDER=PrintSetu <verify@YOUR_VERIFIED_DOMAIN>
PRINTSETU_RAZORPAY_MODE=live
PRINTSETU_RAZORPAY_KEY_ID=
PRINTSETU_RAZORPAY_KEY_SECRET=
PRINTSETU_RAZORPAY_WEBHOOK_SECRET=
PRINTSETU_CLEANUP_INTERVAL_SECONDS=60
PRINTSETU_DOCUMENT_RETENTION_HOURS=6
PRINTSETU_MAX_UPLOAD_BYTES=26214400
